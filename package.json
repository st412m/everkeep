{
  "name": "everkeep",
  "version": "1.1.0",
  "mcpName": "io.github.st412m/everkeep",
  "description": "Everkeep keeps your notes, decisions and projects in one folder on your own server. Your AI assistant reads it when a chat starts and writes down what you worked out — so tomorrow's conversation picks up where today's ended.",
  "license": "MIT",
  "author": "st412m",
  "homepage": "https://github.com/st412m/everkeep#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/st412m/everkeep.git"
  },
  "bugs": "https://github.com/st412m/everkeep/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "memory",
    "vault",
    "claude"
  ],
  "type": "commonjs",
  "bin": {
    "everkeep": "src/cli.js"
  },
  "files": [
    "src/",
    "scripts/",
    "everkeep.example.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "doclines": "0.1.1"
  }
}
